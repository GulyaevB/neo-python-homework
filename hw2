import random

def get_numbers_ticket(min, max, quantity):
    """
    Generate a sorted list of unique random lottery numbers.

    Returns:
        list: Sorted unique numbers, or [] if input is invalid.
    """

    # Check input types
    if type(min) is not int or type(max) is not int or type(quantity) is not int:
        return []

    # Check lottery number range
    if min < 1 or max > 1000 or min > max:
        return []

    # Check requested quantity
    if quantity < 1 or quantity > max - min + 1:
        return []

    # Generate unique random numbers
    numbers = random.sample(range(min, max + 1), quantity)

    return sorted(numbers)


if __name__ == "__main__":
    print(get_numbers_ticket(1, 49, 6))
    print(get_numbers_ticket(1, 36, 5))
    print(get_numbers_ticket(1, 5, 6))
    print(get_numbers_ticket(0, 49, 6))
