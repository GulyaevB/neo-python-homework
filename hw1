
from datetime import datetime


def get_days_from_today(date):
    """
    Calculate the number of days between a given date and today.

    Args:
        date (str): Date in YYYY-MM-DD format.

    Returns:
        int: Number of days from the given date to today.
             Negative if the given date is in the future.
        None: If the input date is invalid.
    """
    try:
        if not isinstance(date, str):
            raise TypeError("Date must be a string")

        given_date = datetime.strptime(date, "%Y-%m-%d").date()

        # Check the exact input format
        if given_date.strftime("%Y-%m-%d") != date:
            raise ValueError("Invalid date format")

        today = datetime.today().date()
        difference = today - given_date

        return difference.days

    except (ValueError, TypeError):
        print("Error: Invalid date. Expected format: YYYY-MM-DD.")
        return None


if __name__ == "__main__":
    print(get_days_from_today("2020-10-09"))
    print(get_days_from_today("2030-01-01"))
    print(get_days_from_today("invalid-date"))
    print(get_days_from_today("2024-02-29"))

