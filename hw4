
from datetime import datetime, timedelta, date


def get_upcoming_birthdays(users):

    today = datetime.today().date()
    upcoming_birthdays = []

    def birthday_in_year(birthday, year):
        try:
            return birthday.replace(year=year)
        except ValueError:
            return date(year, 2, 28)

    for user in users:
        birthday = datetime.strptime(
            user["birthday"], "%Y.%m.%d"
        ).date()

        for year in (today.year - 1, today.year, today.year + 1):
            birthday_date = birthday_in_year(birthday, year)
            congratulation_date = birthday_date

            # Move weekend birthdays to Monday
            if congratulation_date.weekday() == 5:
                congratulation_date += timedelta(days=2)
            elif congratulation_date.weekday() == 6:
                congratulation_date += timedelta(days=1)

            # Include today and the next 7 days
            days_until = (congratulation_date - today).days

            if 0 <= days_until <= 7:
                upcoming_birthdays.append({
                    "name": user["name"],
                    "congratulation_date":
                        congratulation_date.strftime("%Y.%m.%d")
                })
                break

    return upcoming_birthdays


if __name__ == "__main__":
    users = [
        {"name": "John Doe", "birthday": "1985.01.23"},
        {"name": "Jane Smith", "birthday": "1990.01.27"}
    ]

    print(
        "Список привітань на цьому тижні:",
        get_upcoming_birthdays(users)
    )
